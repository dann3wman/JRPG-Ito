+  const enemies = G.enemies.map((u,i)=>({u, x:center+(i%cols-(cols-1)/2)*span/cols,
+    y:8+(rows-1-Math.floor(i/cols))*80/rows, w:span/cols, h:80/rows, face:ambush?-1:1}));
+  const party = actives().map((u,i)=>({u, x:pincer ? (i%2 ? 88 : 12) : ambush ? 16+i*5 : 76+i*5,
+    y:pincer ? (i%2 ? 35 : 56-Math.floor(i/2)*42) : 58-i*25, w:12, h:pincer?26:24,
+    face:pincer ? (i%2 ? -1 : 1) : ambush && G.turned.includes(u.id) ? 1 : -1}));
+  return [...enemies,...party.filter(p=>!p.u.fled)];
+}
