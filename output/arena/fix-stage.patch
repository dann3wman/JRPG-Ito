+const arenaSprites = new Map();
+function arenaSprite(id, src){
+  if (arenaSprites.has(id)) return arenaSprites.get(id);
+  arenaSprites.set(id, src);
+  const img = new Image();
+  img.onload = () => {
+    // The embedded sprites have dark backdrops. Clear only edge-connected backdrop pixels.
+    const cv = document.createElement('canvas'); cv.width = img.width; cv.height = img.height;
+    const ctx = cv.getContext('2d'); ctx.drawImage(img, 0, 0);
+    const pixels = ctx.getImageData(0, 0, cv.width, cv.height), d = pixels.data;
+    const seen = new Uint8Array(cv.width * cv.height), todo = [];
+    const visit = (x,y) => {
+      if (x<0 || y<0 || x>=cv.width || y>=cv.height) return;
+      const p = y*cv.width+x, n = p*4;
+      if (seen[p]) return; seen[p] = 1;
+      if (Math.max(d[n],d[n+1],d[n+2]) > 32) return;
+      d[n+3] = 0; todo.push([x,y]);
+    };
+    for (let x=0;x<cv.width;x++){ visit(x,0); visit(x,cv.height-1); }
+    for (let y=0;y<cv.height;y++){ visit(0,y); visit(cv.width-1,y); }
+    while (todo.length){ const [x,y] = todo.pop(); visit(x-1,y); visit(x+1,y); visit(x,y-1); visit(x,y+1); }
+    ctx.putImageData(pixels,0,0);
+    const clean = cv.toDataURL(); arenaSprites.set(id,clean);
+    document.querySelectorAll(`[data-sprite="${id}"]`).forEach(el=>el.src=clean);
+  };
+  img.src = src;
+  return src;
+}
