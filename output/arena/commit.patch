+const FORMATIONS = {
+  standard:'Standard: enemies left, party right.',
+  pincer:'Pincer: party on both sides, enemies in the middle.',
+  ambush:'Ambush: party left, backs turned until they act.'
+};
+const arenaSprites = new Map();
+function arenaSprite(id, src){
+  if (arenaSprites.has(id)) return arenaSprites.get(id);
+  arenaSprites.set(id, src);
+  const img = new Image();
+  img.onload = () => {
+    // The embedded sprites have dark backdrops. Clear only edge-connected backdrop pixels.
+    const cv = document.createElement('canvas'); cv.width = img.width; cv.height = img.height;
+    const ctx = cv.getContext('2d'); ctx.drawImage(img, 0, 0);
+    const pixels = ctx.getImageData(0, 0, cv.width, cv.height), d = pixels.data;
+    const seen = new Uint8Array(cv.width * cv.height), todo = [];
+    const visit = (x,y) => {
+      if (x<0 || y<0 || x>=cv.width || y>=cv.height) return;
+      const p = y*cv.width+x, n = p*4;
+      if (seen[p]) return; seen[p] = 1;
+      if (Math.max(d[n],d[n+1],d[n+2]) > 32) return;
+      d[n+3] = 0; todo.push([x,y]);
+    };
+    for (let x=0;x<cv.width;x++){ visit(x,0); visit(x,cv.height-1); }
+    for (let y=0;y<cv.height;y++){ visit(0,y); visit(cv.width-1,y); }
+    while (todo.length){ const [x,y] = todo.pop(); visit(x-1,y); visit(x+1,y); visit(x,y-1); visit(x,y+1); }
+    ctx.putImageData(pixels,0,0);
+    const clean = cv.toDataURL(); arenaSprites.set(id,clean);
+    document.querySelectorAll(`[data-sprite="${id}"]`).forEach(el=>el.src=clean);
+  };
+  img.src = src;
+  return src;
+}
+function arenaPositions(){
+  const ambush = G.formation==='ambush', pincer = G.formation==='pincer';
+  const n = G.enemies.length, cols = n>3 ? 2 : 1, rows = Math.ceil(n/cols);
+  const span = pincer ? 42 : 54, center = pincer ? 50 : ambush ? 70 : 30;
+  const enemies = G.enemies.map((u,i)=>({u, x:center+(i%cols-(cols-1)/2)*span/cols,
+    y:8+(rows-1-Math.floor(i/cols))*80/rows, w:span/cols, h:80/rows, face:ambush?-1:1}));
+  const party = actives().map((u,i)=>({u, x:pincer ? (i%2 ? 88 : 12) : ambush ? 16+i*5 : 76+i*5,
+    y:pincer ? (i%2 ? 35 : 56-Math.floor(i/2)*42) : 58-i*25, w:12, h:pincer?26:24,
+    face:pincer ? (i%2 ? -1 : 1) : ambush && G.turned.includes(u.id) ? 1 : -1}));
+  return [...enemies,...party.filter(p=>!p.u.fled)];
+}
+function renderArena(){
+  const stage = $('#arenaStage');
+  const bg = window.RigAnim ? RigAnim.arenaFor(G.enemies[0].art) : 'hillside';
+  stage.style.backgroundImage = `url("tools/bestiary-rig-viewer/bg_${bg}.webp")`;
+  $('#arenaCaption').textContent = FORMATIONS[G.formation];
+  stage.innerHTML = arenaPositions().map(p=>{
+    const u = p.u, enemy = u.side==='enemy';
+    const tgt = G.menu==='target' && G.act && (enemy ? G.act.target==='enemy' && u.alive :
+      (G.act.target==='ally' && u.alive && !u.airborne) || (G.act.target==='ko' && !u.alive && !u.fled));
+    const tag = enemy || tgt ? 'button' : 'div';
+    const action = tgt ? `data-${enemy?'ft':'pt'}="${u.id}"` : enemy ? `data-info="${u.id}"` : '';
+    const state = !u.alive ? (enemy?'Defeated':'KO') : u.airborne ? 'Airborne' : '';
+    const label = `${tgt?'Target ':''}${u.name}${state ? ': '+state : ''}${enemy && !tgt ? ': stats and decision tree' : ''}`;
+    const spriteId = enemy ? 'enemy:'+u.art : u.id;
+    const sprite = arenaSprite(spriteId,enemy ? art(u.art) : ASSETS[u.id].s);
+    const visual = enemy ? (window.RigAnim && RigAnim.box(u.id,u.art,sprite)) || `<img data-sprite="${spriteId}" src="${sprite}" alt="">` :
+      `<img class="sprite" data-sprite="${spriteId}" src="${sprite}" alt="">`;
+    return `<${tag} class="arena-unit${enemy?' enemy':' ally'}${tgt?' targetable':''}${u===G.current?' acting':''}${!u.alive?' dead':''}${u.airborne?' airborne':''}" ${tag==='button'?'type="button"':''} ${action} aria-label="${esc(label)}" data-unit="${u.id}" data-facing="${p.face===1?'right':'left'}" style="--x:${p.x}%;--y:${p.y}%;--w:${p.w}%;--h:${p.h}%;--face:${p.face};z-index:${100-Math.round(p.y)}">
+      ${visual}<span class="unit-name">${esc(u.name)}${state?' · '+state:''}</span>${fxHtml(u.id)}</${tag}>`;
+  }).join('');
+  if (window.RigAnim){ RigAnim.forget(new Set(G.enemies.map(x=>x.id))); RigAnim.mount(stage,new Set(G.enemies.filter(x=>!x.alive).map(x=>x.id))); }
+}
+window.render_game_to_text = () => JSON.stringify(G && {
+  state:G.state, menu:G.menu, formation:G.formation, current:G.current && G.current.id,
+  coordinates:'Percent of arena; x from left, y from bottom; x is center, y is feet.',
+  units:arenaPositions().map(p=>({id:p.u.id, side:p.u.side, x:p.x, y:p.y, facing:p.face===1?'right':'left', hp:p.u.hp, alive:p.u.alive, airborne:!!p.u.airborne})),
+  turnOrder:forecast(16,G.preview).map(f=>f.u.id)
+});
